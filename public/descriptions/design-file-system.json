{"q":"1166","t":"Design File System","d":"Medium","p":true,"c":null,"h":["What if you think of a tree hierarchy for the files?.","A path is a node in the tree.","Use a hash table to store the valid paths along with their values."],"m":"{\n  \"classname\": \"FileSystem\",\n  \"maxbytesperline\": 400000,\n  \"constructor\": {\n    \"params\": []\n  },\n  \"methods\": [\n    {\n      \"name\": \"createPath\",\n      \"params\": [\n        {\n          \"type\": \"string\",\n          \"name\": \"path\"\n        },\n        {\n          \"type\": \"integer\",\n          \"name\": \"value\"\n        }\n      ],\n      \"return\": {\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"name\": \"get\",\n      \"params\": [\n        {\n          \"type\": \"string\",\n          \"name\": \"path\"\n        }\n      ],\n      \"return\": {\n        \"type\": \"integer\"\n      }\n    }\n  ],\n  \"systemdesign\": true,\n  \"params\": [\n    {\n      \"name\": \"inputs\",\n      \"type\": \"integer[]\"\n    },\n    {\n      \"name\": \"inputs\",\n      \"type\": \"integer[]\"\n    }\n  ],\n  \"return\": {\n    \"type\": \"list<String>\",\n    \"dealloc\": true\n  }\n}","g":[{"name":"Hash Table","slug":"hash-table"},{"name":"String","slug":"string"},{"name":"Design","slug":"design"},{"name":"Trie","slug":"trie"}]}